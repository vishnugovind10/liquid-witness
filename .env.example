# Copy to .env, fill in real values, .env is gitignored.
# Use a THROWAWAY testnet wallet/mnemonic generated only for this scan -
# never reuse a wallet that holds anything of value.

WITNESS_ELECTRUM_URL=elements-testnet.blockstream.info:50002
WITNESS_ASSET_ID=<64-char-hex-asset-id>
WITNESS_CT_DESCRIPTOR=<slip77-ct-descriptor-from-throwaway-wallet>
WITNESS_GAID=<gaid-if-needed-for-amp0-lookup>
WITNESS_EXPECT_TXID=<txid-used-as-independent-sanity-check>
